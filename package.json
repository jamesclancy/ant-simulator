{
  "name": "ant-simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @ant/web dev",
    "build": "pnpm --filter @ant/web build",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel typecheck",
    "mobile:sync": "pnpm build && pnpm --filter @ant/mobile exec cap sync",
    "mobile:ios": "pnpm mobile:sync && pnpm --filter @ant/mobile exec cap open ios",
    "mobile:android": "pnpm mobile:sync && pnpm --filter @ant/mobile exec cap open android",
    "bench": "pnpm --filter @ant/bench bench"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.6",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
